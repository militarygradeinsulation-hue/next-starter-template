# Python standard library does not automatically load .env. Export values in your shell.
HOST=127.0.0.1
PORT=8765
# Required if binding a non-loopback HOST; recommend an auth reverse proxy for production.
APP_TOKEN=replace-with-a-long-random-secret
# Optional; defaults to rate-limited public RPC endpoints. Private RPC endpoints recommended.
RPC_URL_ETHEREUM=https://your-ethereum-rpc.example
RPC_URL_BASE=https://your-base-rpc.example
RPC_URL_ARBITRUM=https://your-arbitrum-rpc.example
RPC_URL_POLYGON=https://your-polygon-rpc.example

# Optional. Etherscan V2 API key required for indexed transaction/transfer history.
ETHERSCAN_API_KEY=
# Auto balance scan while this Python process remains alive. 0=off. Minimum 10 minutes.
AUTO_SCAN_INTERVAL_MINUTES=0
AUTO_SCAN_BATCH_LIMIT=10
# With a positive scan interval, advance one active historical discovery queue per tick.
AUTO_DISCOVERY_ENABLED=0

# Phase 3: advance ONE Aave Borrow-event queue each automatic scanning tick.
# This reads public event logs; no transaction signing or broadcast.
AUTO_AAVE_BORROWER_ENABLED=0
